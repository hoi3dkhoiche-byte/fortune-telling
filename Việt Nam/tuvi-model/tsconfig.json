{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2023", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "typeRoots": ["../tuvi-core/node_modules/@types"]
  },
  "include": ["src/**/*.js", "eval/**/*.js", "tests/**/*.js", "index.d.ts"]
}
